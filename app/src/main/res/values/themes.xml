<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Minim" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fg_base</item>
        <item name="colorPrimaryVariant">@color/fg_base</item>
        <item name="colorOnPrimary">@color/bg_base</item>
        <item name="colorSecondary">@color/fg_base</item>
        <item name="colorOnSecondary">@color/bg_base</item>
        <item name="colorAccent">@color/fg_base</item>
        <item name="colorSurface">@color/bg_base</item>
        <item name="colorOnSurface">@color/fg_base</item>
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="android:textColorPrimary">@color/fg_base</item>
        <item name="android:textColorSecondary">@color/minim_muted</item>
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
    </style>

    <style name="Theme.Minim" parent="Base.Theme.Minim">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Text styles: Poppins everywhere, bold for headings, regular for small text -->
    <style name="MinimText">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="MinimText.Small">
        <item name="android:textSize">10sp</item>
    </style>
    <style name="MinimText.Bold">
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>
    <style name="MinimText.Semi">
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <style name="MinimText.Tab">
        <item name="android:textSize">15sp</item>
    </style>
    <style name="MinimText.Logo">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="MinimText.Section">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">12sp</item>
    </style>
    <!-- 5.8.4 u56: the Settings page. Group names, a label per setting, an optional one-line
         hint, then a SegmentRow (one soft track, a sliding thumb) or a soft action pill. -->
    <style name="MinimSet" />
    <style name="MinimSet.Group" parent="MinimText.Semi">
        <item name="android:textSize">18sp</item>
        <item name="android:tag">text:fg</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="MinimSet.Label" parent="MinimText">
        <item name="android:textSize">14sp</item>
        <item name="android:tag">text:fg</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
    </style>
    <style name="MinimSet.Hint" parent="MinimText">
        <item name="android:textSize">11.5sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:tag">text:muted</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>
    <style name="MinimSet.Segments">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="MinimSet.Seg" parent="MinimText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:tag">seg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="MinimSet.Action" parent="MinimText.Semi">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/shape_pill</item>
        <item name="android:tag">fill:soft text:fg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="MinimText.Option">
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/shape_pill_outline</item>
        <item name="android:tag">opt</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
