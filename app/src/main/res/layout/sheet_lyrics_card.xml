<?xml version="1.0" encoding="utf-8"?>
<!-- 6.6.0: the lyrics card's share sheet: a preview of the card, Original / Translation / Both
     (only when a translation is there), then Share with card / Link only below it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <FrameLayout
        android:id="@+id/lyrics_card_box"
        android:layout_width="180dp"
        android:layout_height="320dp"
        android:background="@drawable/shape_card"
        android:tag="fill:soft">

        <ImageView
            android:id="@+id/lyrics_card_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:contentDescription="@string/fs_share_lyrics"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <com.minim.music.ui.SegmentRow
        android:id="@+id/lyrics_card_modes"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/lyrics_card_original"
            style="@style/MinimSet.Seg"
            android:text="@string/lyrics_card_original" />

        <TextView
            android:id="@+id/lyrics_card_translation"
            style="@style/MinimSet.Seg"
            android:text="@string/lyrics_card_translation" />

        <TextView
            android:id="@+id/lyrics_card_both"
            style="@style/MinimSet.Seg"
            android:text="@string/lyrics_card_both" />
    </com.minim.music.ui.SegmentRow>
</LinearLayout>
