<?xml version="1.0" encoding="utf-8"?>
<!-- Top row shared by Home, stories, Stats, Library and (5.8.5 u57) Search: logo (Home, stories and
     Search; stories' + is the first tile of the channel row) or a round search button (Stats/Library),
     then the three tabs and the settings gear. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- 5.8.5 u57: the left area is as wide as what's in it (the logo, or the round search button
         lined up where the logo starts), and the tabs follow it at the same gap they keep between
         themselves. Switching between a logo tab and a search tab slides the tabs to their new
         place (MainActivity.slideTopRow). -->
    <FrameLayout
        android:id="@+id/top_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/top_logo"
            style="@style/MinimText.Logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="34dp"
            android:tag="text:fg"
            android:text="@string/app_logo" />

        <!-- 5.8.5 u57: a round magnifier on every screen size (was a "search" pill that crowded
             the tabs). Screen readers still hear "Search". -->
        <FrameLayout
            android:id="@+id/top_search"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="34dp"
            android:background="@drawable/shape_pill"
            android:clickable="true"
            android:contentDescription="@string/search_button_desc"
            android:focusable="true"
            android:tag="fill:fg"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                android:tag="tint:bg" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/top_tab_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <TextView
            style="@style/MinimText.Tab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="text:fg"
            android:text="@string/tab_home" />

        <View
            android:id="@+id/top_line_home"
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/shape_underline"
            android:tag="fill:fg"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- 5.7.0 u44: stories (was Lab). A small "new" tag until the tab is tapped once. -->
    <LinearLayout
        android:id="@+id/top_tab_stories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/MinimText.Tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="text:fg"
                android:text="@string/tab_stories" />

            <TextView
                android:id="@+id/top_stories_new"
                style="@style/MinimText.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="3dp"
                android:background="@drawable/shape_pill"
                android:includeFontPadding="false"
                android:paddingStart="4dp"
                android:paddingTop="1dp"
                android:paddingEnd="4dp"
                android:paddingBottom="1dp"
                android:tag="fill:fg text:bg"
                android:text="@string/stats_new_tag"
                android:textSize="8sp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:id="@+id/top_line_stories"
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/shape_underline"
            android:tag="fill:fg"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- v4.9: Stats (was Recents). A small "new" tag until the tab is opened once, then a dot
         while a recap hasn't been looked at. -->
    <LinearLayout
        android:id="@+id/top_tab_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/MinimText.Tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="text:fg"
                android:text="@string/tab_stats" />

            <TextView
                android:id="@+id/top_stats_new"
                style="@style/MinimText.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="3dp"
                android:background="@drawable/shape_pill"
                android:includeFontPadding="false"
                android:paddingStart="4dp"
                android:paddingTop="1dp"
                android:paddingEnd="4dp"
                android:paddingBottom="1dp"
                android:tag="fill:fg text:bg"
                android:text="@string/stats_new_tag"
                android:textSize="8sp"
                android:visibility="gone" />

            <View
                android:id="@+id/top_stats_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="top"
                android:layout_marginStart="2dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/shape_pill"
                android:tag="fill:fg"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:id="@+id/top_line_stats"
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/shape_underline"
            android:tag="fill:fg"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/top_tab_library"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <TextView
            style="@style/MinimText.Tab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="text:fg"
            android:text="@string/tab_library" />

        <View
            android:id="@+id/top_line_library"
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/shape_underline"
            android:tag="fill:fg"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- v5.0: profile picture (Google photo, or a placeholder) in place of the gear; opens Settings -->
    <com.minim.music.ui.AvatarView
        android:id="@+id/top_gear"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="1dp"
        android:clickable="true"
        android:contentDescription="@string/settings"
        android:focusable="true"
        android:padding="5dp" />
</LinearLayout>
