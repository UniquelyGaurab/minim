<?xml version="1.0" encoding="utf-8"?>
<!-- Pill mini player: round cover art, song + artist, like / play-pause / next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="54dp"
    android:background="@drawable/shape_pill"
    android:clickable="true"
    android:elevation="6dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="7dp"
    android:paddingEnd="6dp"
    android:tag="fill:fg">

    <ImageView
        android:id="@+id/mini_art"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/shape_circle"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:tag="fill:bg" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mini_title"
            style="@style/MinimText.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="10dp"
            android:singleLine="true"
            android:tag="text:bg"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/mini_artist"
            style="@style/MinimText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="10dp"
            android:singleLine="true"
            android:tag="text:bg"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/mini_like"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/like"
        android:padding="8dp"
        android:src="@drawable/ic_heart_outline"
        android:tag="tint:bg" />

    <ImageView
        android:id="@+id/mini_play"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/play"
        android:padding="6dp"
        android:src="@drawable/ic_play"
        android:tag="tint:bg" />

    <ImageView
        android:id="@+id/mini_next"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/next"
        android:padding="6dp"
        android:src="@drawable/ic_next"
        android:tag="tint:bg" />
</LinearLayout>
