<?xml version="1.0" encoding="utf-8"?>
<!-- 6.6.0: "Shared with you", when a Minim link opens. The cover (a 2x2 collage for a playlist),
     the title, the artist or song count, "Shared by <name>", the first few songs of a playlist,
     then Save and Play. Colours come from the palette tags, like every sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/shared_label"
        style="@style/MinimText.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:tag="text:fg"
        android:text="@string/shared_with_you" />

    <FrameLayout
        android:id="@+id/shared_cover_box"
        android:layout_width="168dp"
        android:layout_height="168dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/shape_card"
        android:tag="fill:soft">

        <ImageView
            android:id="@+id/shared_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <GridLayout
            android:id="@+id/shared_collage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="2"
            android:rowCount="2"
            android:visibility="gone">

            <ImageView
                android:id="@+id/shared_collage_0"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/shared_collage_1"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/shared_collage_2"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/shared_collage_3"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </GridLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/shared_title"
        style="@style/MinimText.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:tag="text:fg"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/shared_subtitle"
        style="@style/MinimText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.75"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:tag="text:fg"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/shared_by"
        style="@style/MinimText.Semi"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/shape_pill"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:tag="fill:soft text:fg"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/shared_songs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/shared_more"
        style="@style/MinimText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.6"
        android:gravity="center"
        android:tag="text:fg"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/shared_save"
            style="@style/MinimText.Semi"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/shape_pill_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:tag="fill:fg text:fg"
            android:text="@string/shared_save"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/shared_play"
            style="@style/MinimText.Semi"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/shape_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:tag="fill:fg text:bg"
            android:text="@string/shared_play"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
