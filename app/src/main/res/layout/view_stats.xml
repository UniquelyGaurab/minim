<?xml version="1.0" encoding="utf-8"?>
<!-- v4.9: Stats tab (replaces Recents). Today's live numbers on top, then the recap of the most
     recent past day with listening, and its story ("dive in"). All colours from the palette. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_stats"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:orientation="vertical"
    android:tag="bg"
    android:visibility="gone">

    <include
        android:id="@+id/stats_top"
        layout="@layout/view_top_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/stats_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="110dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="26dp"
            android:paddingEnd="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/MinimText.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="text:fg"
                    android:text="@string/stats_today"
                    android:textSize="22sp" />

                <TextView
                    style="@style/MinimText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_pill"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:tag="fill:soft text:fg"
                    android:text="@string/stats_live"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/stats_today_date"
                style="@style/MinimText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:tag="text:muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/stats_today_songs_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/shape_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:tag="fill:soft">

                    <TextView
                        android:id="@+id/stats_today_songs"
                        style="@style/MinimText.Bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:tag="text:fg"
                        android:text="0"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/stats_today_songs_label"
                        style="@style/MinimText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:tag="text:muted"
                        android:text="@string/stats_songs"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/shape_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:tag="fill:soft">

                    <TextView
                        android:id="@+id/stats_today_time"
                        style="@style/MinimText.Bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:tag="text:fg"
                        android:text="0"
                        android:textSize="22sp" />

                    <TextView
                        
                        style="@style/MinimText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:tag="text:muted"
                        android:text="@string/stats_time"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/stats_today_artists_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/shape_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:tag="fill:soft">

                    <TextView
                        android:id="@+id/stats_today_artists"
                        style="@style/MinimText.Bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:tag="text:fg"
                        android:text="0"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/stats_today_artists_label"
                        style="@style/MinimText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:tag="text:muted"
                        android:text="@string/stats_artists"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/shape_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:tag="fill:soft">

                    <TextView
                        android:id="@+id/stats_today_streak"
                        style="@style/MinimText.Bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:tag="text:fg"
                        android:text="0"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/stats_today_streak_label"
                        style="@style/MinimText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:tag="text:muted"
                        android:text="@string/stats_day_streak"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- v4.9.2: today's top artist, full width with their photo (tap: Artist page) -->
            <LinearLayout
                android:id="@+id/stats_today_artist_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:tag="fill:soft"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/stats_today_artist_photo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/shape_circle"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:tag="fill:fg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MinimText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="text:muted"
                        android:text="@string/stats_top_artist"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/stats_today_top_artist"
                        style="@style/MinimText.Bold"
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:layout_marginTop="2dp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeMinTextSize="11sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:tag="text:fg" />

                    <TextView
                        android:id="@+id/stats_today_top_artist_sub"
                        style="@style/MinimText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:tag="text:muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- v4.9: the most recent day when it was quiet (it doesn't replace a better recap) -->
            <TextView
                android:id="@+id/stats_quiet_line"
                style="@style/MinimText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_card"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:tag="fill:soft text:muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                style="@style/MinimText.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:tag="text:fg"
                android:text="@string/stats_recap"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/stats_recap_date"
                style="@style/MinimText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:tag="text:muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/stats_recap_empty"
                style="@style/MinimText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:tag="text:muted"
                android:text="@string/stats_recap_empty"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/stats_recap_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/stats_recap_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/shape_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:tag="fill:fg">

                    <TextView
                        style="@style/MinimText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="text:bg"
                        android:text="@string/stats_you_listened"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/stats_recap_time"
                        style="@style/MinimText.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:tag="text:bg"
                        android:textSize="34sp" />

                    <TextView
                        android:id="@+id/stats_recap_quiet"
                        style="@style/MinimText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:tag="text:bg"
                        android:text="@string/stats_quiet_day"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/stats_dive_in"
                            style="@style/MinimText.Semi"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/shape_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:tag="fill:bg text:fg"
                            android:text="@string/recap_dive_in"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/stats_open_card"
                            style="@style/MinimText.Semi"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/shape_pill_outline"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:tag="fill:bg text:bg"
                            android:text="@string/recap_card"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/shape_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:tag="fill:soft">

                    <TextView
                        android:id="@+id/stats_recap_songs"
                        style="@style/MinimText.Bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:tag="text:fg"
                        android:text="0"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/stats_recap_songs_label"
                        style="@style/MinimText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:tag="text:muted"
                        android:text="@string/stats_songs"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/shape_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:tag="fill:soft">

                    <TextView
                        android:id="@+id/stats_recap_artists"
                        style="@style/MinimText.Bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:tag="text:fg"
                        android:text="0"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/stats_recap_artists_label"
                        style="@style/MinimText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:tag="text:muted"
                        android:text="@string/stats_artists"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/stats_top_song"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:tag="fill:soft">

                <ImageView
                    android:id="@+id/stats_top_song_art"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/shape_art_small"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:tag="fill:fg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MinimText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="text:muted"
                        android:text="@string/stats_top_song"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/stats_top_song_title"
                        style="@style/MinimText.Semi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:tag="text:fg"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/stats_top_song_sub"
                        style="@style/MinimText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:tag="text:muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/stats_top_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:tag="fill:soft">

                <ImageView
                    android:id="@+id/stats_top_artist_photo"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/shape_circle"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:tag="fill:fg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MinimText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="text:muted"
                        android:text="@string/stats_top_artist"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/stats_top_artist_name"
                        style="@style/MinimText.Semi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:tag="text:fg"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/stats_top_artist_sub"
                        style="@style/MinimText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:tag="text:muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/stats_peak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:tag="fill:soft">

                <TextView
                    style="@style/MinimText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="text:muted"
                    android:text="@string/stats_peak_hour"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/stats_peak_text"
                    style="@style/MinimText.Semi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:tag="text:fg"
                    android:textSize="15sp" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/stats_streak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:tag="fill:soft">

                <TextView
                    style="@style/MinimText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="text:muted"
                    android:text="@string/stats_longest_streak"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/stats_streak_text"
                    style="@style/MinimText.Semi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:tag="text:fg"
                    android:textSize="15sp" />
            </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
