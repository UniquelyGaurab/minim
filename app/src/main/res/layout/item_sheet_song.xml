<?xml version="1.0" encoding="utf-8"?>
<!-- v4.9.2 one song in a sheet list (today's songs): cover, title, artist, plays on the right.
     Same soft fill as the song menu's pill rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/shape_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp"
    android:tag="fill:soft">

    <ImageView
        android:id="@+id/song_art"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/shape_art_small"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:tag="fill:fg" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/song_title"
            style="@style/MinimText.Semi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:tag="text:fg"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/song_artist"
            style="@style/MinimText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:ellipsize="end"
            android:singleLine="true"
            android:tag="text:fg"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/song_plays"
        style="@style/MinimText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:alpha="0.65"
        android:singleLine="true"
        android:tag="text:fg"
        android:textSize="13sp" />
</LinearLayout>
