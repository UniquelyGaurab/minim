<?xml version="1.0" encoding="utf-8"?>
<!-- v4.6 Search: an artist result is a rounded pill (songs are rounded rectangles).
     v4.9.6: filled with the same soft tint, cover size and text sizes as the song rows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="36dp"
    android:paddingEnd="36dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/artist_pill"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/shape_pill"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="20dp"
        android:tag="fill:soft">

        <ImageView
            android:id="@+id/artist_photo_small"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/shape_circle"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:tag="fill:fg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/artist_result_name"
                style="@style/MinimText.Semi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:tag="text:fg"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/artist_result_subs"
                style="@style/MinimText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:ellipsize="end"
                android:singleLine="true"
                android:tag="text:fg"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:alpha="0.55"
            android:importantForAccessibility="no"
            android:rotation="-90"
            android:src="@drawable/ic_chevron_down"
            android:tag="tint:fg" />
    </LinearLayout>
</FrameLayout>
