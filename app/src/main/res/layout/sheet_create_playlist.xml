<?xml version="1.0" encoding="utf-8"?>
<!-- v4.8 new playlist: one big rounded name box and a "create" pill that stays faded until you type -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <EditText
        android:id="@+id/sheet_name_input"
        style="@style/MinimText.Semi"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/shape_box_outline"
        android:hint="@string/playlist_name_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="40"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:singleLine="true"
        android:tag="text:fg fill:fg"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/sheet_name_error"
        style="@style/MinimText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:tag="text:fg"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sheet_create"
        style="@style/MinimText.Semi"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:alpha="0.35"
        android:background="@drawable/shape_pill"
        android:enabled="false"
        android:gravity="center"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:tag="fill:fg text:bg"
        android:text="@string/sheet_create"
        android:textSize="15sp" />
</LinearLayout>
