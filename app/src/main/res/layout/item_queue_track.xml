<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/queue_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="26dp"
    android:layout_marginEnd="22dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/shape_card_outline"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp"
    android:tag="fill:fg">

    <ImageView
        android:id="@+id/queue_art"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/shape_art_small"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:tag="fill:fg" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/queue_title"
            style="@style/MinimText.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:tag="text:fg"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/queue_artist"
            style="@style/MinimText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:tag="text:fg"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/queue_up"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/move_up"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_up"
        android:tag="tint:fg" />

    <ImageView
        android:id="@+id/queue_down"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/move_down"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_down"
        android:tag="tint:fg" />

    <ImageView
        android:id="@+id/queue_remove"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/remove"
        android:padding="9dp"
        android:src="@drawable/ic_close"
        android:tag="tint:fg" />
</LinearLayout>
