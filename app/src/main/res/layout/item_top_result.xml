<?xml version="1.0" encoding="utf-8"?>
<!-- Search: the big filled "TOP RESULT" card -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="36dp"
    android:paddingEnd="36dp">

    <LinearLayout
        android:id="@+id/top_card"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:background="@drawable/shape_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:tag="fill:fg">

        <TextView
            style="@style/MinimText.Semi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:tag="text:bg"
            android:text="@string/top_result"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/top_art"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/shape_art_small"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:tag="fill:bg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/top_title"
                    style="@style/MinimText.Bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:tag="text:bg"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/top_artist"
                    style="@style/MinimText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:tag="text:bg"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
