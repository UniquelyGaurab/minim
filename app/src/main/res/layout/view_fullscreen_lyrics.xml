<?xml version="1.0" encoding="utf-8"?>
<!--
  v4.9.8 full screen lyrics (replaces the old lyrics screen). It sits right above Now Playing and
  reaches behind the status and navigation bars (MainActivity gives it negative margins, like the
  Home takeover). Bottom to top: the blurred cover (two images that crossfade on a song change),
  a scrim, the lyric lines, a message for loading / no lyrics, the double tap play/pause pulse
  and the progress bar, which slides here from Now Playing. Colours come from the cover
  (FullscreenLyrics), so the palette painter leaves all of it alone (tag "unpainted").
-->
<com.minim.music.ui.FullscreenLyricsLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_fs_lyrics"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:tag="unpainted"
    android:visibility="gone">

    <FrameLayout
        android:id="@+id/fs_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="noHideDescendants">

        <FrameLayout
            android:id="@+id/fs_images"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/fs_bg_a"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/fs_bg_b"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <View
            android:id="@+id/fs_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fs_lines"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:clipToPadding="true"
        android:fadingEdgeLength="88dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/fs_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- 5.8.1 (update 53): Gemini lyrics. The panel takes the middle when a song has no lyrics:
         the offer, the "Listening..." wait (cover-colour bars + Cancel) and short error notes.
         The AI line sits just above the bar while AI lyrics show, and the regenerate button top
         left (FullscreenLyrics places both and colours them in the lyric ink). -->
    <LinearLayout
        android:id="@+id/fs_ai_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/fs_ai_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:maxWidth="320dp"
            android:textSize="16sp" />

        <com.minim.music.ui.AiListeningView
            android:id="@+id/fs_ai_wait"
            android:layout_width="72dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/fs_ai_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="44dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/fs_ai_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:maxWidth="280dp"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/fs_ai_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:alpha="0"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/ai_lyrics_disclaimer"
        android:textSize="11sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/fs_ai_redo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="6dp"
        android:alpha="0"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/ai_lyrics_regenerate"
        android:focusable="true"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_ai_redo"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/fs_pulse"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_pause" />

    <!-- 5.6.0: AI translation. The button sits top right (FullscreenLyrics sets its top margin
         below the status bar and shows it only for lyrics that aren't English); the note shows
         in the top middle when Gemini couldn't translate. -->
    <ImageView
        android:id="@+id/fs_translate"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="14dp"
        android:alpha="0"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/fs_translate_show"
        android:focusable="true"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_translate"
        android:visibility="gone" />
    <TextView
        android:id="@+id/fs_translate_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:alpha="0"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxWidth="240dp"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="@string/fs_translate_failed"
        android:textSize="13sp"
        android:visibility="gone" />
    <!-- 5.7.0 u46: stories uploads with more than one caption track: tap to switch (top right,
         where songs have the translate button, which captions don't get). -->
    <TextView
        android:id="@+id/fs_caption_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:alpha="0"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:maxWidth="200dp"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:textSize="13sp"
        android:visibility="gone" />
    <!-- 5.7.0: the same animated bar as Now Playing (5.5.0): it thickens and grows a thumb when
         grabbed, with a time pill above the finger. A little bigger than the line (padding) so
         the grabbed bar and its thumb fit; the line itself stays 280dp wide where it was. -->
    <com.minim.music.ui.ProgressLine
        android:id="@+id/fs_bar"
        android:layout_width="300dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

    <TextView
        android:id="@+id/fs_seek_pill"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="top|start"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:minWidth="52dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="13sp"
        android:visibility="invisible" />
</com.minim.music.ui.FullscreenLyricsLayout>
