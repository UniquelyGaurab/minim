<?xml version="1.0" encoding="utf-8"?>
<!--
  v4.2 Now Playing, top to bottom: back pill, "You're vibing to", cover art, the current lyric
  line (v4.9.8: tap it for full screen lyrics), title, artist, progress + controls, "Up Next" pill.
  The weighted Space views share the spare height so a tall 20:9 screen has no empty band;
  each also has a small fixed height so a short screen still breathes. MainActivity keeps the
  art at 73% of the width and shrinks it only when the screen is too short for everything.
-->
<!-- v4.9.8: the screen (colour, touch blocking) wraps np_content, so the full screen lyrics can
     fade everything on Now Playing out while the background colour stays put. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_now_playing"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:tag="bg"
    android:visibility="gone"
    tools:ignore="MergeRootFrame,UselessParent">

<LinearLayout
    android:id="@+id/np_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- v4.9.7: the collapse pill stays in the centre; the 3 dot menu sits at the top right -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:paddingStart="24dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/np_back"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@drawable/shape_pill"
            android:contentDescription="@string/minimise_player"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:src="@drawable/ic_chevron_down"
            android:tag="fill:fg tint:bg" />

        <ImageView
            android:id="@+id/np_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/np_more"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            android:tag="tint:fg" />

        <!-- 5.7.0 u46: stories uploads only. 6.1.1: turns their captions on and off (off by default;
             faded while off). Songs never show it, so their top row is unchanged. -->
        <ImageView
            android:id="@+id/np_cc"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/np_captions"
            android:padding="8dp"
            android:src="@drawable/ic_closed_caption"
            android:tag="tint:fg"
            android:visibility="gone" />

        <!-- 5.7.0 u47: tapes only: save the tape offline (the heart below likes it), so tapes
             show up under Liked and Offline's Tapes filter -->
        <FrameLayout
            android:id="@+id/np_download"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="80dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/np_download"
            android:visibility="gone">

            <ImageView
                android:id="@+id/np_download_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_offline"
                android:tag="tint:fg" />

            <com.minim.music.ui.ProgressRing
                android:id="@+id/np_download_ring"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 5.7.0 u47: the sleep timer's live countdown, top left, on the same line as the
             collapse pill and the menu. Tap it to change or stop the timer. -->
        <LinearLayout
            android:id="@+id/np_sleep"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/np_sleep_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bedtime"
                android:tag="tint:fg" />

            <TextView
                android:id="@+id/np_sleep_text"
                style="@style/MinimText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:tag="text:fg"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <Space
        android:id="@+id/np_gap_top"
        android:layout_width="1dp"
        android:layout_height="18dp"
        android:layout_weight="0.5" />

    <TextView
        android:id="@+id/np_vibing"
        style="@style/MinimText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="text:fg"
        android:text="@string/youre_vibing_to"
        android:textSize="15sp" />

    <Space
        android:id="@+id/np_gap_label"
        android:layout_width="1dp"
        android:layout_height="14dp"
        android:layout_weight="0.3" />

    <ImageView
        android:id="@+id/np_art"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/shape_card"
        android:contentDescription="@string/album_art"
        android:scaleType="centerCrop"
        android:tag="fill:fg" />

    <Space
        android:id="@+id/np_gap_art"
        android:layout_width="1dp"
        android:layout_height="16dp"
        android:layout_weight="1.2" />

    <!-- The current synced lyric line. Fixed height: nothing moves when it wraps or is empty.
         v4.9.8: tappable when the song has lyrics (opens full screen lyrics); a faint
         "Lyrics not available" otherwise. MainActivity sets clickable / TalkBack.
         v4.9.9: its own view: Flow word by word, centred lines with side margins and a max
         width (set in code), the old line slides up as the next one slides in. -->
    <com.minim.music.ui.NowPlayingLyricView
        android:id="@+id/np_lyric"
        android:layout_width="match_parent"
        android:layout_height="68dp" />

    <Space
        android:id="@+id/np_gap_lyric"
        android:layout_width="1dp"
        android:layout_height="14dp"
        android:layout_weight="1.0" />

    <TextView
        android:id="@+id/np_title"
        style="@style/MinimText.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:tag="text:fg"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/np_artist"
        style="@style/MinimText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="40dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:tag="text:fg"
        android:textSize="16sp" />

    <Space
        android:id="@+id/np_gap_meta"
        android:layout_width="1dp"
        android:layout_height="18dp"
        android:layout_weight="0.8" />

    <include
        android:id="@+id/np_controls"
        layout="@layout/view_player_controls"
        android:layout_width="300dp"
        android:layout_height="wrap_content" />

    <Space
        android:id="@+id/np_gap_controls"
        android:layout_width="1dp"
        android:layout_height="16dp"
        android:layout_weight="0.7" />

    <!-- v4.9.8: the "Up Next" pill replaces "swipe up for lyrics" (same total height: 30 + 16 dp).
         5.2.0: the Gemini pill sits next to it. -->
    <LinearLayout
        android:id="@+id/np_pill_row"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/np_up_next"
            style="@style/MinimText.Semi"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/shape_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:tag="fill:fg text:bg"
            android:text="@string/np_up_next"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/np_gemini"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/shape_pill"
            android:clickable="true"
            android:contentDescription="@string/gemini_open"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:tag="fill:fg">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sparkle"
                android:tag="tint:bg" />

            <TextView
                style="@style/MinimText.Semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:tag="text:bg"
                android:text="@string/gemini_np_pill"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
<!-- 5.5.0: the time pill that floats above the finger while dragging the seek bar -->
<TextView
    android:id="@+id/np_seek_pill"
    android:layout_width="wrap_content"
    android:layout_height="28dp"
    android:background="@drawable/shape_pill"
    android:fontFamily="@font/poppins_medium"
    android:gravity="center"
    android:includeFontPadding="false"
    android:minWidth="52dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:tag="fill:fg text:bg"
    android:textSize="13sp"
    android:visibility="invisible"
    tools:text="2:47" />

</FrameLayout>
