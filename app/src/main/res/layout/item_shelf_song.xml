<?xml version="1.0" encoding="utf-8"?>
<!-- v4.3 Discover shelf song: cover, title, artist (same look as the Recents tiles) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="120dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp">

        <ImageView
            android:id="@+id/song_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_card"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:tag="fill:fg" />

        <View
            android:id="@+id/song_outline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_card_outline"
            android:tag="fill:fg"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/song_title"
        style="@style/MinimText.Semi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:tag="text:fg"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/song_artist"
        style="@style/MinimText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:tag="text:muted"
        android:textSize="10sp" />
</LinearLayout>
