<?xml version="1.0" encoding="utf-8"?>
<!-- 5.2.0 (Android 12 and newer): same as backup_rules.xml, for cloud backups and phone-to-phone
     transfers: everything as before, except your Gemini key settings (minim_ai.xml).
     5.9.0: also this phone's Fermata id (minim_fermata_device.xml) and its listening session
     (minim_fermata.xml), so a restored or new phone gets its own id. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="minim_ai.xml" />
        <exclude domain="sharedpref" path="minim_fermata_device.xml" />
        <exclude domain="sharedpref" path="minim_fermata.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="minim_ai.xml" />
        <exclude domain="sharedpref" path="minim_fermata_device.xml" />
        <exclude domain="sharedpref" path="minim_fermata.xml" />
    </device-transfer>
</data-extraction-rules>
