<?xml version="1.0" encoding="utf-8"?>
<!-- Songs in Liked Songs, a playlist or an album.
     6.8.0: the header (cover, title, pills) sits over the list and scrolls away with it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:tag="bg"
    android:visibility="gone"
    tools:ignore="MergeRootFrame">

        <com.minim.music.ui.FadingRecyclerView
            android:id="@+id/list_tracks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="22dp"
            android:paddingBottom="120dp" />

        <TextView
            android:id="@+id/list_empty"
            style="@style/MinimText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:tag="text:muted"
            android:textSize="12sp"
            android:visibility="gone" />
        <com.minim.music.ui.ScrollThroughHeader
            android:id="@+id/list_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="2dp">

        <!-- 6.8.0: the cover (same rounded square as the Library tiles); share and "+ Add songs" top right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="24dp"
            android:orientation="horizontal">

            <com.minim.music.ui.PlaylistCoverView
                android:id="@+id/list_cover"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:importantForAccessibility="no" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 6.6.0: share the playlist (a Minim link and card) -->
            <ImageView
                android:id="@+id/list_share"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/shape_pill"
                android:clickable="true"
                android:contentDescription="@string/share_playlist_desc"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_share"
                android:tag="fill:soft tint:fg"
                android:visibility="gone" />

            <TextView
                android:id="@+id/list_add_songs"
                style="@style/MinimText.Semi"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/shape_pill"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:tag="fill:fg text:bg"
                android:text="@string/add_songs"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp">

            <TextView
                android:id="@+id/list_title"
                style="@style/MinimText.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:tag="text:fg"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/list_title_edit"
                style="@style/MinimText.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/rename_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="40"
                android:padding="0dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:tag="text:fg"
                android:textCursorDrawable="@null"
                android:textSize="22sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 5.3.2: "from [logo] · 25 songs"; the logo is tinted with the app colour -->
        <LinearLayout
            android:id="@+id/list_subtitle_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/list_source_from"
                style="@style/MinimText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:tag="text:fg"
                android:text="@string/list_from"
                android:textSize="11sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/list_source_logo"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:tag="tint:fg"
                android:visibility="gone" />

            <TextView
                android:id="@+id/list_subtitle"
                style="@style/MinimText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:tag="text:fg"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 5.7.0 u47: Liked and Offline: Songs or Tapes (hidden on other lists) -->
        <LinearLayout
            android:id="@+id/list_filter_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/list_filter_songs"
                style="@style/MinimText"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/list_filter_songs"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/list_filter_tapes"
                style="@style/MinimText"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/list_filter_tapes"
                android:textSize="12sp" />

            <!-- 5.7.0 u48: Liked only: the artists you liked on their Artist page -->
            <TextView
                android:id="@+id/list_filter_artists"
                style="@style/MinimText"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/list_filter_artists"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 6.8.0: Play, Shuffle, search and the ⋯ menu, like the Artist page's pills -->
        <LinearLayout
            android:id="@+id/list_pills"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginStart="36dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/list_play"
                style="@style/MinimText.Semi"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/shape_pill"
                android:clickable="true"
                android:contentDescription="@string/list_play_desc"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:tag="fill:fg text:bg"
                android:text="@string/list_play"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/list_shuffle"
                style="@style/MinimText.Semi"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/shape_pill"
                android:clickable="true"
                android:contentDescription="@string/list_shuffle_desc"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:tag="fill:soft text:fg"
                android:text="@string/artist_shuffle"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/list_search_pill"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/shape_pill"
                android:clickable="true"
                android:contentDescription="@string/list_search_desc"
                android:focusable="true"
                android:tag="fill:soft">

                <LinearLayout
                    android:id="@+id/list_search_label"
                    tools:ignore="UseCompoundDrawables"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        android:tag="tint:fg" />

                    <TextView
                        style="@style/MinimText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        android:tag="text:fg"
                        android:text="@string/search"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list_search_box"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="0dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        android:tag="tint:fg" />

                    <EditText
                        android:id="@+id/list_search_input"
                        style="@style/MinimText"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/list_search_hint"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:tag="text:fg"
                        android:textCursorDrawable="@null"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/list_search_close"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/list_search_close"
                        android:padding="10dp"
                        android:src="@drawable/ic_close"
                        android:tag="tint:fg" />
                </LinearLayout>
            </FrameLayout>

            <ImageView
                android:id="@+id/list_more"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/shape_pill"
                android:clickable="true"
                android:contentDescription="@string/list_more_desc"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_more_horiz"
                android:tag="fill:soft tint:fg"
                android:visibility="gone" />
        </LinearLayout>
        </com.minim.music.ui.ScrollThroughHeader>
</FrameLayout>
