<?xml version="1.0" encoding="utf-8"?>
<!-- v4.3 Discover tab: top row + calm vertical list of shelves (pull down to refresh) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_discover"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:orientation="vertical"
    android:tag="bg"
    android:visibility="gone">

    <include
        android:id="@+id/discover_top"
        layout="@layout/view_top_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/discover_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/discover_shelves"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="26dp"
                android:paddingBottom="110dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- v4.7: not enough listening yet. A big headline like the welcome screens. -->
        <LinearLayout
            android:id="@+id/discover_welcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingTop="72dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/discover_welcome_title"
                style="@style/MinimText.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="0.86"
                android:tag="text:fg"
                android:text="@string/discover_welcome_title"
                android:textSize="38sp" />

            <TextView
                android:id="@+id/discover_welcome_sub"
                style="@style/MinimText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:lineSpacingMultiplier="1.1"
                android:tag="text:muted"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/discover_message"
            style="@style/MinimText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:tag="text:muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
