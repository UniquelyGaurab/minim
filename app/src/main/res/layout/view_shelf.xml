<?xml version="1.0" encoding="utf-8"?>
<!-- v4.3 one Discover shelf in full: back pill, title, Play all, 2-column grid (Recents style) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_shelf"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:orientation="vertical"
    android:tag="bg"
    android:visibility="gone">

    <ImageView
        android:id="@+id/shelf_back"
        android:layout_width="48dp"
        android:layout_height="28dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/shape_pill"
        android:contentDescription="@string/shelf_back"
        android:padding="6dp"
        android:rotation="90"
        android:src="@drawable/ic_chevron_down"
        android:tag="fill:fg tint:bg" />

    <TextView
        android:id="@+id/shelf_page_title"
        style="@style/MinimText.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="30dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:tag="text:fg"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/shelf_page_count"
            style="@style/MinimText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:tag="text:muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/shelf_play_all"
            style="@style/MinimText.Semi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:tag="fill:fg text:bg"
            android:text="@string/play_all"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shelf_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="30dp"
        android:paddingTop="26dp"
        android:paddingEnd="30dp"
        android:paddingBottom="110dp" />
</LinearLayout>
