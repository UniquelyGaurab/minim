<?xml version="1.0" encoding="utf-8"?>
<!-- 6.8.0 b72: a Tapes search result: the video's thumbnail at YouTube's own 16:9 (like the Tapes
     tab's cards), its title on up to two lines and the channel under it, in a soft row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/tape_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/shape_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:tag="fill:soft">

        <ImageView
            android:id="@+id/tape_art"
            android:layout_width="112dp"
            android:layout_height="63dp"
            android:background="@drawable/shape_art_small"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:tag="fill:fg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tape_title"
                style="@style/MinimText.Semi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:tag="text:fg"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tape_meta"
                style="@style/MinimText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:ellipsize="end"
                android:singleLine="true"
                android:tag="text:fg"
                android:textSize="12sp" />
        </LinearLayout>
</LinearLayout>
