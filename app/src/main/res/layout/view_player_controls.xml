<?xml version="1.0" encoding="utf-8"?>
<!-- Progress bar, times and the controls row, shared by Now Playing and Lyrics. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- 5.5.0: a little bigger than it looks (the negative margins keep the old 20dp footprint
         and the padding keeps the line where it was) so the grabbed 3x bar and its thumb fit -->
    <com.minim.music.ui.ProgressLine
        android:id="@+id/pc_progress"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginStart="-10dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-10dp"
        android:layout_marginBottom="-4dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp">

        <TextView
            android:id="@+id/pc_elapsed"
            style="@style/MinimText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="text:fg"
            android:text="@string/time_zero"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/pc_remaining"
            style="@style/MinimText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:tag="text:fg"
            android:text="@string/time_zero_remaining"
            android:textSize="10sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/pc_like"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_circle"
            android:contentDescription="@string/like"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:src="@drawable/ic_heart_outline"
            android:tag="fill:fg tint:bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/shape_pill"
            android:orientation="horizontal"
            android:tag="fill:fg">

            <TextView
                android:id="@+id/pc_prev"
                style="@style/MinimText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:tag="text:bg"
                android:text="@string/previous"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pc_play"
                style="@style/MinimText.Semi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:tag="text:bg"
                android:text="@string/play"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pc_next"
                style="@style/MinimText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:tag="text:bg"
                android:text="@string/next"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/pc_repeat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_circle"
            android:contentDescription="@string/repeat_off"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_repeat"
            android:tag="fill:fg tint:bg" />
    </LinearLayout>
</LinearLayout>
