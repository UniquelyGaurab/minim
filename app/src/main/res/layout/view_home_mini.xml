<?xml version="1.0" encoding="utf-8"?>
<!-- v4.9.7 Home "You're listening" pill: only the round cover, song and artist. Tapping it opens
     Now Playing. Like / play-pause / next sit below it as three circles (home_mini_actions). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:background="@drawable/shape_pill"
    android:clickable="true"
    android:elevation="6dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="3dp"
    android:paddingEnd="18dp"
    android:tag="fill:fg">

    <ImageView
        android:id="@+id/mini_art"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/shape_circle"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:tag="fill:bg" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mini_title"
            style="@style/MinimText.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="10dp"
            android:singleLine="true"
            android:tag="text:bg"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/mini_artist"
            style="@style/MinimText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="10dp"
            android:singleLine="true"
            android:tag="text:bg"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
