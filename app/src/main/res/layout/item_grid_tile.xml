<?xml version="1.0" encoding="utf-8"?>
<!-- Library / Recents grid tile: rounded square + bold label (+ artist for Recents) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="21dp"
    android:paddingEnd="21dp"
    android:paddingBottom="34dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tile_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/tile_art"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/shape_card"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:tag="fill:fg"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/tile_outline"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/shape_card_outline"
            android:tag="fill:fg"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tile_art"
            app:layout_constraintEnd_toEndOf="@id/tile_art"
            app:layout_constraintStart_toStartOf="@id/tile_art"
            app:layout_constraintTop_toTopOf="@id/tile_art" />

        <ImageView
            android:id="@+id/tile_plus"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_add"
            android:tag="tint:fg"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tile_art"
            app:layout_constraintEnd_toEndOf="@id/tile_art"
            app:layout_constraintStart_toStartOf="@id/tile_art"
            app:layout_constraintTop_toTopOf="@id/tile_art" />

        <!-- 5.4.0: a ring in the corner while the playlist saves offline -->
        <FrameLayout
            android:id="@+id/tile_ring_box"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="8dp"
            android:background="@drawable/shape_circle"
            android:padding="6dp"
            android:tag="fill:bg"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tile_art"
            app:layout_constraintEnd_toEndOf="@id/tile_art">

            <com.minim.music.ui.ProgressRing
                android:id="@+id/tile_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/offline_saving_cd"
                android:tag="tint:fg" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tile_title"
        style="@style/MinimText.Semi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:tag="text:fg"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tile_subtitle"
        style="@style/MinimText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:tag="text:fg"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- 5.4.0: "from [full logo]" under an imported playlist's name -->
    <LinearLayout
        android:id="@+id/tile_from_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tile_from"
            style="@style/MinimText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="no"
            android:tag="text:fg"
            android:text="@string/list_from"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/tile_logo"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tag="tint:fg" />
    </LinearLayout>
</LinearLayout>
