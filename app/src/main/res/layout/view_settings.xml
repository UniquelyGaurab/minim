<?xml version="1.0" encoding="utf-8"?>
<!-- 5.8.4 u56: Settings, the minim way. Was one long list of 17 equal headings with small
     outline pills; now eight short groups (You, Look, Sound, Lyrics, Gestures, Gemini, Storage,
     About), one label per setting, a one-line hint only where it helps, and every choice is a
     SegmentRow: one soft track with a sliding thumb behind the chosen option (44dp tall, the
     whole row width, so every option is easy to hit). Long privacy text folds away. All the old
     ids are kept, so the settings code and the saved values are untouched. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    android:tag="bg"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:paddingBottom="56dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="-12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/MinimText.Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:tag="text:fg"
                android:text="@string/settings"
                android:textSize="26sp" />

            <ImageView
                android:id="@+id/settings_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:padding="13dp"
                android:src="@drawable/ic_close"
                android:tag="tint:fg" />
        </LinearLayout>

        <!-- 6.5.0: the V6 notice, first thing in Settings. One line, folded; a tap anywhere on the
             card opens the full note in place and another tap folds it again. It can't be closed:
             no X, no saved "dismissed" state. The body keeps 6.1.1's readable text:body colour. -->
        <LinearLayout
            android:id="@+id/settings_v6_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/shape_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:tag="fill:soft">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/settings_v6_notice_line"
                    style="@style/MinimText.Semi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:lineSpacingExtra="2dp"
                    android:tag="text:fg"
                    android:text="@string/v6_notice_line"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/settings_v6_notice_chev"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down"
                    android:tag="tint:muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_v6_notice_body"
                style="@style/MinimSet.Hint"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="30dp"
                android:lineSpacingExtra="4dp"
                android:tag="text:body"
                android:text="@string/v6_notice_body"
                android:textSize="12.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 5.10.1 (V6): Profile, in place of the Google account. Your photo and name, on this
             phone only. Tapping the photo opens Choose / Take / Remove; tapping the name edits it
             (the same name the Home greetings use). -->
        <LinearLayout
            android:id="@+id/settings_group_you"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.minim.music.ui.AvatarView
                android:id="@+id/profile_photo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/profile_photo_desc"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/settings_name"
                    style="@style/MinimText.Semi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/settings_name"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="20"
                    android:minHeight="48dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:singleLine="true"
                    android:tag="text:fg"
                    android:textCursorDrawable="@null"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/profile_hint"
                    style="@style/MinimSet.Hint"
                    android:layout_marginTop="0dp"
                    android:text="@string/profile_hint" />
            </LinearLayout>
        </LinearLayout>

        <!-- 5.10.1: Backup &amp; restore, right under the profile (was at the bottom of Storage) -->
        <LinearLayout
            android:id="@+id/settings_group_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="vertical">

            <TextView
                style="@style/MinimSet.Group"
                android:accessibilityHeading="true"
                android:text="@string/settings_group_backup" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MinimSet.Label"
                        android:layout_marginTop="0dp"
                        android:text="@string/backup_folder" />

                    <TextView
                        android:id="@+id/set_backup_folder_hint"
                        style="@style/MinimSet.Hint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/set_backup_folder"
                    style="@style/MinimSet.Action"
                    android:layout_marginStart="12dp"
                    android:text="@string/backup_folder_choose" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MinimSet.Label"
                        android:layout_marginTop="0dp"
                        android:text="@string/backup_now_label" />

                    <TextView
                        android:id="@+id/set_backup_status"
                        style="@style/MinimSet.Hint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/set_backup_now"
                    style="@style/MinimSet.Action"
                    android:layout_marginStart="12dp"
                    android:text="@string/backup_now"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MinimSet.Label"
                        android:layout_marginTop="0dp"
                        android:text="@string/backup_restore_label" />

                    <TextView
                        android:id="@+id/set_backup_restore_hint"
                        style="@style/MinimSet.Hint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/set_backup_restore"
                    style="@style/MinimSet.Action"
                    android:layout_marginStart="12dp"
                    android:text="@string/backup_restore"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Look -->
        <LinearLayout
            android:id="@+id/settings_group_look"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="vertical">

            <TextView
                style="@style/MinimSet.Group"
                android:accessibilityHeading="true"
                android:text="@string/settings_group_look" />

            <TextView
                style="@style/MinimSet.Label"
                android:text="@string/settings_theme" />

            <com.minim.music.ui.SegmentRow style="@style/MinimSet.Segments">

                <TextView
                    android:id="@+id/set_theme_light"
                    style="@style/MinimSet.Seg"
                    android:text="@string/theme_light" />

                <TextView
                    android:id="@+id/set_theme_dark"
                    style="@style/MinimSet.Seg"
                    android:text="@string/theme_dark" />
            </com.minim.music.ui.SegmentRow>

            <TextView
                style="@style/MinimSet.Label"
                android:text="@string/settings_colours" />

            <TextView
                style="@style/MinimSet.Hint"
                android:text="@string/colours_hint" />

            <com.minim.music.ui.SegmentRow style="@style/MinimSet.Segments">

                <TextView
                    android:id="@+id/set_colours_dynamic"
                    style="@style/MinimSet.Seg"
                    android:text="@string/colours_dynamic" />

                <TextView
                    android:id="@+id/set_colours_default"
                    style="@style/MinimSet.Seg"
                    android:text="@string/colours_default" />
            </com.minim.music.ui.SegmentRow>
        </LinearLayout>

        <!-- Sound -->
        <LinearLayout
            android:id="@+id/settings_group_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="vertical">

            <TextView
                style="@style/MinimSet.Group"
                android:accessibilityHeading="true"
                android:text="@string/settings_group_sound" />

            <TextView
                style="@style/MinimSet.Label"
                android:text="@string/settings_boost" />

            <TextView
                style="@style/MinimSet.Hint"
                android:text="@string/boost_hint_short" />

            <com.minim.music.ui.SegmentRow style="@style/MinimSet.Segments">

                <TextView
                    android:id="@+id/set_boost_off"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_off" />

                <TextView
                    android:id="@+id/set_boost_normal"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_boost_normal" />

                <TextView
                    android:id="@+id/set_boost_loud"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_boost_loud" />
            </com.minim.music.ui.SegmentRow>

            <TextView
                style="@style/MinimSet.Label"
                android:text="@string/settings_bass" />

            <TextView
                style="@style/MinimSet.Hint"
                android:text="@string/bass_hint_short" />

            <com.minim.music.ui.SegmentRow style="@style/MinimSet.Segments">

                <TextView
                    android:id="@+id/set_bass_off"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_off" />

                <TextView
                    android:id="@+id/set_bass_warm"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_bass_warm" />

                <TextView
                    android:id="@+id/set_bass_punchy"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_bass_punchy" />

                <TextView
                    android:id="@+id/set_bass_heavy"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_bass_heavy" />
            </com.minim.music.ui.SegmentRow>

            <TextView
                style="@style/MinimSet.Label"
                android:text="@string/settings_fade" />

            <TextView
                style="@style/MinimSet.Hint"
                android:text="@string/fade_hint" />

            <com.minim.music.ui.SegmentRow style="@style/MinimSet.Segments">

                <TextView
                    android:id="@+id/set_fade_off"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_off" />

                <TextView
                    android:id="@+id/set_fade_2"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_fade_2" />

                <TextView
                    android:id="@+id/set_fade_4"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_fade_4" />
            </com.minim.music.ui.SegmentRow>
        </LinearLayout>

        <!-- Lyrics -->
        <LinearLayout
            android:id="@+id/settings_group_lyrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="vertical">

            <TextView
                style="@style/MinimSet.Group"
                android:accessibilityHeading="true"
                android:text="@string/settings_group_lyrics" />

            <TextView
                style="@style/MinimSet.Label"
                android:text="@string/settings_lyrics_style_short" />

            <TextView
                style="@style/MinimSet.Hint"
                android:text="@string/lyrics_style_hint_short" />

            <com.minim.music.ui.SegmentRow style="@style/MinimSet.Segments">

                <TextView
                    android:id="@+id/set_lyrics_flow"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_lyrics_flow" />

                <TextView
                    android:id="@+id/set_lyrics_line"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_lyrics_line" />
            </com.minim.music.ui.SegmentRow>

            <TextView
                style="@style/MinimSet.Label"
                android:text="@string/settings_lyrics_timing_short" />

            <TextView
                style="@style/MinimSet.Hint"
                android:text="@string/lyrics_timing_hint" />

            <!-- The stepper: − value +, on the same soft track as the choices -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:tag="fill:soft">

                <TextView
                    android:id="@+id/set_lyrics_minus"
                    style="@style/MinimText.Semi"
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="0dp"
                    android:clickable="true"
                    android:contentDescription="@string/lyrics_timing_later"
                    android:focusable="true"
                    android:gravity="center"
                    android:tag="text:fg"
                    android:text="@string/lyrics_timing_minus"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/set_lyrics_value"
                    style="@style/MinimText.Semi"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:contentDescription="@string/lyrics_timing_reset"
                    android:focusable="true"
                    android:gravity="center"
                    android:tag="text:fg"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/set_lyrics_plus"
                    style="@style/MinimText.Semi"
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="0dp"
                    android:clickable="true"
                    android:contentDescription="@string/lyrics_timing_earlier"
                    android:focusable="true"
                    android:gravity="center"
                    android:tag="text:fg"
                    android:text="@string/lyrics_timing_plus"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Gestures (on the album art in Now Playing) and haptics -->
        <LinearLayout
            android:id="@+id/settings_group_gestures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="vertical">

            <TextView
                style="@style/MinimSet.Group"
                android:accessibilityHeading="true"
                android:text="@string/settings_group_gestures" />

            <TextView
                style="@style/MinimSet.Hint"
                android:layout_marginTop="4dp"
                android:text="@string/gestures_hint" />

            <TextView
                style="@style/MinimSet.Label"
                android:layout_marginTop="20dp"
                android:text="@string/gesture_swipe" />

            <com.minim.music.ui.SegmentRow style="@style/MinimSet.Segments">

                <TextView
                    android:id="@+id/set_swipe_skip"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_skip" />

                <TextView
                    android:id="@+id/set_swipe_off"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_off" />
            </com.minim.music.ui.SegmentRow>

            <TextView
                style="@style/MinimSet.Label"
                android:text="@string/gesture_double_tap" />

            <com.minim.music.ui.SegmentRow style="@style/MinimSet.Segments">

                <TextView
                    android:id="@+id/set_dtap_play"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_play_pause" />

                <TextView
                    android:id="@+id/set_dtap_like"
                    style="@style/MinimSet.Seg"
                    android:text="@string/like" />

                <TextView
                    android:id="@+id/set_dtap_off"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_off" />
            </com.minim.music.ui.SegmentRow>

            <TextView
                style="@style/MinimSet.Label"
                android:text="@string/gesture_long_press" />

            <com.minim.music.ui.SegmentRow style="@style/MinimSet.Segments">

                <TextView
                    android:id="@+id/set_lpress_lyrics"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_lyrics" />

                <TextView
                    android:id="@+id/set_lpress_off"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_off" />
            </com.minim.music.ui.SegmentRow>

            <TextView
                style="@style/MinimSet.Label"
                android:text="@string/settings_haptics" />

            <com.minim.music.ui.SegmentRow style="@style/MinimSet.Segments">

                <TextView
                    android:id="@+id/set_haptics_on"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_on" />

                <TextView
                    android:id="@+id/set_haptics_off"
                    style="@style/MinimSet.Seg"
                    android:text="@string/opt_off" />
            </com.minim.music.ui.SegmentRow>
        </LinearLayout>

        <!-- Gemini: model (opens the picker sheet) and your own key (5.10.1: needed for every Gemini feature) -->
        <LinearLayout
            android:id="@+id/settings_group_gemini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/set_gemini_header"
                style="@style/MinimSet.Group"
                android:accessibilityHeading="true"
                android:text="@string/set_gemini" />

            <LinearLayout
                android:id="@+id/set_gemini_privacy_toggle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="2dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/MinimText.Semi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="text:muted"
                    android:text="@string/set_gemini_privacy_toggle"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/set_gemini_privacy_chev"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down"
                    android:tag="tint:muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/set_gemini_privacy"
                style="@style/MinimSet.Hint"
                android:layout_width="match_parent"
                android:layout_marginTop="0dp"
                android:text="@string/set_gemini_privacy"
                android:visibility="gone" />

            <!-- Model: label on the left, the picked model on the right; the row opens the sheet -->
            <LinearLayout
                android:id="@+id/set_gemini_model_row"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/shape_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="14dp"
                android:tag="fill:soft">

                <TextView
                    style="@style/MinimText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:tag="text:fg"
                    android:text="@string/set_gemini_model" />

                <TextView
                    android:id="@+id/set_gemini_model_pick"
                    style="@style/MinimText.Semi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:importantForAccessibility="no"
                    android:singleLine="true"
                    android:tag="text:fg"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:rotation="-90"
                    android:src="@drawable/ic_chevron_down"
                    android:tag="tint:muted" />
            </LinearLayout>

            <TextView
                style="@style/MinimSet.Label"
                android:text="@string/set_gemini_key" />

            <TextView
                android:id="@+id/set_gemini_key_status"
                style="@style/MinimSet.Hint"
                android:layout_width="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/set_gemini_key_add"
                    style="@style/MinimSet.Action"
                    android:layout_marginEnd="8dp"
                    android:text="@string/set_gemini_key_add" />

                <TextView
                    android:id="@+id/set_gemini_key_remove"
                    style="@style/MinimSet.Action"
                    android:text="@string/set_gemini_key_remove"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

        <!-- Storage: what Minim keeps on the phone, each with its own button -->
        <LinearLayout
            android:id="@+id/settings_group_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="vertical">

            <TextView
                style="@style/MinimSet.Group"
                android:accessibilityHeading="true"
                android:text="@string/settings_storage" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MinimSet.Label"
                        android:layout_marginTop="0dp"
                        android:text="@string/settings_offline" />

                    <TextView
                        android:id="@+id/set_offline_storage"
                        style="@style/MinimSet.Hint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/set_offline_remove_all"
                    style="@style/MinimSet.Action"
                    android:layout_marginStart="12dp"
                    android:text="@string/offline_remove_all"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MinimSet.Label"
                        android:layout_marginTop="0dp"
                        android:text="@string/settings_cache" />

                    <TextView
                        style="@style/MinimSet.Hint"
                        android:text="@string/cache_hint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/set_clear_cache"
                    style="@style/MinimSet.Action"
                    android:layout_marginStart="12dp"
                    android:text="@string/cache_clear" />
            </LinearLayout>


        </LinearLayout>

        <!-- About: version and the update check side by side, then credits -->
        <LinearLayout
            android:id="@+id/settings_group_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="vertical">

            <TextView
                style="@style/MinimSet.Group"
                android:accessibilityHeading="true"
                android:text="@string/settings_about" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/set_about"
                        style="@style/MinimText.Semi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="text:fg"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/set_about_build"
                        style="@style/MinimSet.Hint" />
                </LinearLayout>

                <!-- v4.9.6: the only place to check for updates by hand (the check on every open is quiet) -->
                <TextView
                    android:id="@+id/set_check_updates"
                    style="@style/MinimSet.Action"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="0dp"
                    android:text="@string/update_check" />
            </LinearLayout>

            <TextView
                android:id="@+id/set_credits"
                style="@style/MinimSet.Hint"
                android:layout_marginTop="28dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/about_credits" />
        </LinearLayout>
        <!-- 5.10.1: Clear history on its own at the very bottom, after a line, so nobody taps it by
             accident. It still asks first. -->
        <View
            android:id="@+id/settings_danger_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="56dp"
            android:alpha="0.4"
            android:background="@drawable/shape_card"
            android:tag="fill:muted" />

        <LinearLayout
            android:id="@+id/settings_group_danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/MinimSet.Label"
                    android:layout_marginTop="0dp"
                    android:text="@string/history_clear_label" />

                <TextView
                    style="@style/MinimSet.Hint"
                    android:text="@string/history_clear_hint" />
            </LinearLayout>

            <TextView
                android:id="@+id/set_clear_history"
                style="@style/MinimSet.Action"
                android:layout_marginStart="12dp"
                android:text="@string/history_clear" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
