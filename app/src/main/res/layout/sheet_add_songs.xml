<?xml version="1.0" encoding="utf-8"?>
<!-- 5.3.2: "+ Add songs" sheet on a playlist: a search box, then songs with a + (or a tick). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <EditText
        android:id="@+id/add_songs_input"
        style="@style/MinimText.Semi"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/shape_box_outline"
        android:hint="@string/add_songs_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="100"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:singleLine="true"
        android:tag="text:fg fill:fg"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/add_songs_status"
        style="@style/MinimText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:alpha="0.7"
        android:tag="text:fg"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/add_songs_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />
</LinearLayout>
