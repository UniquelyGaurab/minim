<?xml version="1.0" encoding="utf-8"?>
<!-- Library / Recents grid tile: rounded square + bold label (+ artist for Recents) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="21dp"
    android:paddingEnd="21dp"
    android:paddingBottom="34dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tile_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/tile_art"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/shape_card"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:tag="fill:fg"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/tile_outline"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/shape_card_outline"
            android:tag="fill:fg"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tile_art"
            app:layout_constraintEnd_toEndOf="@id/tile_art"
            app:layout_constraintStart_toStartOf="@id/tile_art"
            app:layout_constraintTop_toTopOf="@id/tile_art" />

        <ImageView
            android:id="@+id/tile_plus"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_add"
            android:tag="tint:fg"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tile_art"
            app:layout_constraintEnd_toEndOf="@id/tile_art"
            app:layout_constraintStart_toStartOf="@id/tile_art"
            app:layout_constraintTop_toTopOf="@id/tile_art" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tile_title"
        style="@style/MinimText.Semi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:tag="text:fg"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tile_subtitle"
        style="@style/MinimText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:tag="text:fg"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
