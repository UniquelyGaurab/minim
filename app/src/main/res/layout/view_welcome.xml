<?xml version="1.0" encoding="utf-8"?>
<!--
    v4.7: welcome screens, shown only on first launch (fresh install or cleared app data).
    Always white with black text, whatever the in-app Light/Dark setting: no palette tags here,
    so the runtime painter never recolours them. Three pages share one "minim" wordmark.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_welcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <TextView
        android:id="@+id/welcome_logo"
        style="@style/MinimText.Logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="28dp"
        android:text="@string/app_logo"
        android:textColor="#FF000000" />

    <!-- Screen 1 -->
    <LinearLayout
        android:id="@+id/welcome_page_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="64dp"
        android:paddingEnd="36dp"
        android:paddingBottom="72dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="30" />

        <TextView
            android:id="@+id/welcome_title_1"
            style="@style/MinimText.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="0.86"
            android:text="@string/welcome_title_1"
            android:textColor="#FF000000"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/welcome_desc_1"
            style="@style/MinimText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="24dp"
            android:lineSpacingMultiplier="1.1"
            android:text="@string/welcome_desc_1"
            android:textColor="#99000000"
            android:textSize="14sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="50" />

        <TextView
            android:id="@+id/welcome_next"
            style="@style/MinimText.Semi"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/shape_pill"
            android:backgroundTint="#FF000000"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/welcome_next"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Screen 2 -->
    <LinearLayout
        android:id="@+id/welcome_page_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="64dp"
        android:paddingEnd="36dp"
        android:paddingBottom="72dp"
        android:visibility="gone">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="22" />

        <TextView
            android:id="@+id/welcome_title_2"
            style="@style/MinimText.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="0.86"
            android:text="@string/welcome_title_2"
            android:textColor="#FF000000"
            android:textSize="40sp" />

        <EditText
            android:id="@+id/welcome_name"
            style="@style/MinimText"
            android:layout_width="230dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:background="@drawable/shape_pill_outline"
            android:backgroundTint="#FF000000"
            android:hint="@string/welcome_name_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="20"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="#FF000000"
            android:textColorHint="#66000000"
            android:textCursorDrawable="@null"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/welcome_go"
            style="@style/MinimText.Semi"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:background="@drawable/shape_pill"
            android:backgroundTint="#FF000000"
            android:ellipsize="none"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/welcome_skip"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="58" />
    </LinearLayout>

    <!-- Screen 3: no button, goes to Home by itself after 3 seconds -->
    <LinearLayout
        android:id="@+id/welcome_page_3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="64dp"
        android:paddingEnd="36dp"
        android:paddingBottom="48dp"
        android:visibility="gone">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="12" />

        <TextView
            android:id="@+id/welcome_title_3"
            style="@style/MinimText.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="0.86"
            android:text="@string/welcome_title_3"
            android:textColor="#FF000000"
            android:textSize="40sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="88" />
    </LinearLayout>
</FrameLayout>
